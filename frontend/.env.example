# URL base da API backend — deve incluir /api e sem barra no final
# Local:      http://localhost:3001/api
# Produção:   https://fernandomodas-production.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# Chave de API interna (mesma do backend). Em produção, configure no Vercel.
VITE_API_KEY=sua_api_key_interna_aqui
