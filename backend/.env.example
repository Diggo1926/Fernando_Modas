# Banco de Dados PostgreSQL (Railway)
DATABASE_URL="postgresql://usuario:senha@host:porta/banco?sslmode=require"

# Porta do servidor
PORT=3001

# Ambiente (development | production)
NODE_ENV=development

# Chave de API interna (gere um secret longo e aleatório)
API_KEY=seu_secret_longo_e_aleatorio_aqui

# JWT Secrets
JWT_SECRET=seu_jwt_secret_longo_aqui
JWT_REFRESH_SECRET=seu_refresh_secret_longo_aqui

# Cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# CORS — domínios permitidos separados por vírgula
CORS_ORIGINS=http://localhost:5173,https://seu-app.vercel.app
