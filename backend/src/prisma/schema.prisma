// Schema Prisma — Diva Modas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id           Int      @id @default(autoincrement())
  nome         String
  categoria    String
  tamanho      String
  cor          String
  quantidade   Int      @default(0)
  precoCusto   Decimal  @db.Decimal(10, 2)
  precoVenda   Decimal  @db.Decimal(10, 2)
  codigo       String?  @unique
  fotoUrl      String?
  fotoPublicId String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendas   Venda[]
  entradas EntradaEstoque[]

  @@map("produtos")
}

model Venda {
  id              Int      @id @default(autoincrement())
  produtoId       Int
  quantidade      Int
  valorTotal      Decimal  @db.Decimal(10, 2)
  // JSON: [{ forma: "PIX" | "Dinheiro" | "Débito" | "Crédito", valor: number }]
  formasPagamento String
  parcelas        Int?
  cancelada       Boolean  @default(false)
  dataHora        DateTime @default(now())
  caixaId         Int?

  produto Produto          @relation(fields: [produtoId], references: [id])
  caixa   FechamentoCaixa? @relation(fields: [caixaId], references: [id])

  @@map("vendas")
}

model FechamentoCaixa {
  id            Int      @id @default(autoincrement())
  data          DateTime
  totalGeral    Decimal  @db.Decimal(10, 2)
  totalPix      Decimal  @db.Decimal(10, 2)
  totalDinheiro Decimal  @db.Decimal(10, 2)
  totalDebito   Decimal  @db.Decimal(10, 2)
  totalCredito  Decimal  @db.Decimal(10, 2)
  totalPecas    Int
  createdAt     DateTime @default(now())

  vendas Venda[]

  @@map("fechamentos_caixa")
}

model EntradaEstoque {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  quantidade Int
  data       DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("entradas_estoque")
}
